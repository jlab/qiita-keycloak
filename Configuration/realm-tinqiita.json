{
  "realm": "tinqiita",
  "enabled": true,
  "displayName": "tinqiita realm",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,

  "roles": {
    "realm": [
      {
        "name": "qiita-user",
        "description": "Default role for Qiita users"
      }
    ]
  },

  "defaultRoles": [
    "qiita-user"
  ],

  "clients": [
    {
      "clientId": "tinqiita",
      "name": "tinqiita Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "SUPERSECRET",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://tinqiita-nginx-1:8383/auth/login_OIDC/*"
      ],
      "webOrigins": [
        "https://qiita.local:8383",
        "https://localhost:8383"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    }
  ],

  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "test@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "test123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "qiita-user"
      ]
    }
  ]
}